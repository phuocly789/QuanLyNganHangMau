# ---------------------------------------------------------------------
# Kết nối SQL Server qua ODBC
# ---------------------------------------------------------------------
# Tên driver ODBC đã cài trên máy chạy web:
#   ODBC Driver 17 for SQL Server  hoặc  ODBC Driver 18 for SQL Server
DB_DRIVER=ODBC Driver 17 for SQL Server

# SQL Server cùng máy: localhost (đi qua shared memory, không cần bật TCP)
# SQL Server trên VPS: <IP hoặc tên miền>,<cổng>  – ví dụ 203.0.113.10,1433
DB_SERVER=localhost

DB_NAME=QuanLyNganHangMau

# Tùy chọn ODBC bổ sung (để trống nếu chạy cùng máy). Khi kết nối VPS:
#   Driver 18 (mặc định bật mã hóa), chứng chỉ tự ký: Encrypt=yes;TrustServerCertificate=yes;
#   Driver 17 hoặc không mã hóa:                     Encrypt=no;
DB_ODBC_OPTIONS=

# ---------------------------------------------------------------------
# Mật khẩu 3 tài khoản demo – dùng cho nút "chuyển nhanh vai trò"
# (phải khớp mật khẩu CREATE LOGIN trên SQL Server)
# ---------------------------------------------------------------------
DEMO_PASSWORD_NHANVIEN01=NhanVien@2026
DEMO_PASSWORD_BACSI01=BacSi@2026
DEMO_PASSWORD_QUANLY01=QuanLy@2026
